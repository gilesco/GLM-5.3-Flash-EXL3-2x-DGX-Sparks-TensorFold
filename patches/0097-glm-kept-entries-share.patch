+def kept_entries(configured: int, share_pct: float, budget: int, state: int) -> tuple[int, str]:
+    """How many kept prompt states ``--parallel`` reserves memory for and keeps: (count, a note for the log, "" when
+    nothing changed).
+
+    Each kept state owns ``state`` bytes outside the pool (its KDA recurrent state and conv window, the indexer rings'
+    tail and the DFlash2 window copy: ~45 MiB), reserved at start out of ``budget`` (what TF_GLM_CACHE_GIB leaves the
+    pool beyond the window), so the count is a memory reservation, not only a limit. ``share_pct`` (TF_GLM_CACHE_SHARE_PCT,
+    0: off) makes the count at least that share of the budget -- a pool-sized count, so a pool of millions of free
+    tokens is not pushed empty by 32 one-shot conversations. Past three quarters of the budget the count is cut: the
+    states would own memory the start-up estimate never counted. Pure arithmetic, the same on every rank."""
+
+    state = max(1, state)
+    n = max(1, configured)
+    note = ""
+    if share_pct > 0:
+        n = max(n, int(budget * min(share_pct, 75.0) / 100 // state))
+        note = f"{n} (at least {share_pct:g}% of the {budget / 2 ** 30:.1f} GiB the pool shares, ~{state >> 20} MiB each)"
+    ceiling = max(1, int(budget * 0.75) // state)
+    if n > ceiling:
+        n = ceiling
+        note = (f"{n}, not the {configured} asked: they would take more than three quarters of the {budget / 2 ** 30:.1f} "
+                f"GiB the pool shares ({state >> 20} MiB each reserved at start)")
+    return n, note
+
