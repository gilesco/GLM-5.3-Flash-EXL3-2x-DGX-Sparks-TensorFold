+def quantize_rows(x: torch.Tensor, gs: int = 64) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Inputs for ``prefill_matmul8``: e4m3 bytes in fragment order, group sums over the row scale, the row scales."""
