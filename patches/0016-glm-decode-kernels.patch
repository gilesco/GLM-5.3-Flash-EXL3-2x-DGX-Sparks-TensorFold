+    // grouped_kernel's PF loop as it is (a runtime loop: unrolling it measured slower)
+    uint32_t words[NT], a[4];
+#pragma unroll
+    for (int i = 0; i < NT; ++i) words[i] = __ldg(tile + i * 32);
