+
+def _pattern(t: dict) -> str:
+    if t.get("hybrid_override_pattern"):
+        return "".join(t["hybrid_override_pattern"])
+    return "".join({"mamba": "M", "attention": "*", "moe": "E", "mlp": "-"}[k] for k in t["layers_block_type"])
