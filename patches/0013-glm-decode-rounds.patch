+    slots = int(t.get("num_experts_per_tok", 1)) + 1
+    intermediate = int(t.get("moe_intermediate_size", t.get("intermediate_size", d))) // world
+    extent = d + int(t["vocab_size"]) // world + slots * (intermediate + d) + width + h * hd
