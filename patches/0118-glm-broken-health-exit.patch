@@ -76,6 +76,14 @@ def watchdog_seconds(value: str | None = None) -> float:
     return s
 
 
+def exit_on_broken(value: str | None = None) -> bool:
+    """Opt-in process exit when the ranks can no longer be trusted to agree."""
+    raw = (os.environ.get("TF_GLM_EXIT_ON_BROKEN", "") if value is None else value).strip() or "0"
+    if raw not in ("0", "1"):
+        raise ValueError(f"TF_GLM_EXIT_ON_BROKEN: 0 or 1, not {raw!r}")
+    return raw == "1"
+
+
 def watchdog_exits(value: str | None = None) -> bool:
     """TF_GLM_MULTI_WATCHDOG_EXIT: 1 ends the process after the watchdog's first stack dump (a stalled server then
     exits with code 1, so a supervisor can restart it, instead of holding its requests forever); 0 (default): dumps
@@ -564,6 +572,7 @@ class MultiDecoder:
         self.next_chat = 0
         self.outbox: list[int] = []
         self.idle = True
+        self.exit_on_broken = exit_on_broken()
         self.broken: Exception | None = None
         self.requeue: list[Stream] = []                  # rank 0: streams given back to the scheduler's queue
         self.eos = tuple(self.w.cfg.eos)
@@ -612,6 +621,22 @@ class MultiDecoder:
                 "iteration_s": round(time.monotonic() - since, 1)
                 if (since := getattr(self, "iteration_since", None)) is not None else 0.0}
 
+    def _break(self, exc: Exception) -> None:
+        # Every error path latches its first cause before any cleanup that might itself fail or hang.
+        if self.broken is None:
+            self.broken = exc
+            if self.exit_on_broken:
+                import sys
+                import traceback
+
+                try:
+                    print("[tensorfold] engine broken; TF_GLM_EXIT_ON_BROKEN=1: exiting with code 1",
+                          file=sys.stderr, flush=True)
+                    traceback.print_exception(type(exc), exc, exc.__traceback__, file=sys.stderr)
+                    sys.stderr.flush()
+                finally:
+                    os._exit(1)   # SystemExit in the scheduler thread would leave the HTTP process alive.
+
     def _check(self) -> None:
         if self.broken is not None:
             raise RuntimeError("the two ranks are out of step after an error; restart both") from self.broken
